{
  "name": "cli-cursor-usage-tracker",
  "version": "1.3.2",
  "description": "A CLI tool to track and visualize your Cursor AI usage and cost in dollars",
  "main": "dist/index.js",
  "bin": {
    "cursor-usage": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "build": "tsc",
    "test": "node --import tsx tests/run-tests.ts",
    "demo": "node --import tsx tests/cli-demo.ts",
    "check": "node --import tsx scripts/check-ts-errors.ts",
    "lint": "npm run check",
    "prepublishOnly": "npm run build",
    "clean": "node --import tsx src/index.ts --clean"
  },
  "keywords": [
    "cursor",
    "ai",
    "usage",
    "tracker",
    "cli",
    "visualization"
  ],
  "author": "Guilherme Guerzoni <guerzoni.guilherme@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g-guerzoni/cli-cursor-usage-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/g-guerzoni/cli-cursor-usage-tracker/issues"
  },
  "homepage": "https://github.com/g-guerzoni/cli-cursor-usage-tracker#readme",
  "dependencies": {
    "@types/readline-sync": "^1.4.8",
    "axios": "^1.8.1",
    "readline-sync": "^1.4.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
